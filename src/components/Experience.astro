---
const credentials = [
  {
    code: 'GRADO UNIVERSITARIO',
    badge: 'Egresado',
    title: 'Ingeniería en Sistemas y Redes Informáticas',
    institution: 'Universidad Gerardo Barrios (UGB) · Graduación programada: diciembre de 2026',
    description:
      'Formación en ingeniería de software, análisis de sistemas, bases de datos, redes y resolución de problemas tecnológicos orientados al negocio.',
    highlights: ['Software y Sistemas', 'Bases de Datos & Redes', 'Análisis de Requisitos'],
    parallax: '-0.05',
  },
  {
    code: 'ESPECIALIZACIÓN',
    badge: 'Cloud Architecture',
    title: 'Preespecialización en Cloud Computing',
    institution: 'Universidad Gerardo Barrios (UGB) · Finalizada en agosto de 2026',
    description:
      'Fundamentos de servicios, infraestructura y despliegue en entornos de nube con enfoque en AWS y Microsoft Azure.',
    highlights: ['Fundamentos de AWS', 'Microsoft Azure', 'Despliegue Cloud'],
    parallax: '0.05',
  },
  {
    code: 'FORMACIÓN PROFESIONAL',
    badge: 'En curso',
    title: 'Bootcamp de Desarrollo Web Junior',
    institution: 'Academia Kodigo · Finalización prevista: diciembre de 2026',
    description:
      'Formación práctica en HTML5 semántico, CSS3, JavaScript, Git y desarrollo web orientado a proyectos. React inicia en noviembre de 2026.',
    highlights: ['HTML5 & CSS3', 'JavaScript', 'Git y GitHub'],
    parallax: '-0.04',
  },
];

const professionalHighlights = [
  {
    code: 'EXPERIENCIA LABORAL',
    badge: '21 años',
    title: 'Facturación nacional y atención mayorista',
    institution: 'Almacén José N. Batarse',
    description:
      'Gestión de facturación y documentación comercial para clientes mayoristas a nivel nacional, con seguimiento de pedidos, consultas e incidencias.',
    highlights: ['Procesos comerciales', 'Atención al cliente', 'Software administrativo'],
  },
  {
    code: 'SOPORTE TI',
    badge: 'Práctico',
    title: 'Sistemas, equipos y redes',
    institution: 'Diagnóstico y mantenimiento informático',
    description:
      'Instalación de Windows, resolución de fallas de hardware y software, configuración de routers, switches y redes Wi-Fi.',
    highlights: ['Hardware y software', 'Redes Wi-Fi', 'Mantenimiento'],
  },
  {
    code: 'OBJETIVO PROFESIONAL',
    badge: 'Disponible',
    title: 'Operaciones con componente tecnológico',
    institution: 'Soporte TI · Administración · Servicios informáticos',
    description:
      'Busco oportunidades donde pueda unir organización, atención al cliente, seguimiento de procesos y soluciones digitales.',
    highlights: ['Orden y responsabilidad', 'Aprendizaje autónomo', 'Comunicación comercial'],
  },
];

const steps = [
  {
    step: '01',
    phase: 'Ingeniería & Semántica',
    time: 'Fase Estructural',
    title: 'Análisis de Sistemas y Esquema DOM Semántico',
    description:
      'Aplicación de principios de Ingeniería en Sistemas para modelar la información con etiquetas HTML5 nativas (<header>, <main>, <section>, <article>), garantizando SEO y accesibilidad WCAG.',
  },
  {
    step: '02',
    phase: 'Desarrollo en Astro',
    time: 'Fase de Compilación',
    title: 'Arquitectura Modular Zero-JS & Activos Optimizados',
    description:
      'Construcción de componentes reutilizables en Astro 5 con estándares de Kodigo Academy, conversión automática de imágenes y eliminación de bloqueos en el navegador.',
  },
  {
    step: '03',
    phase: 'Coreografía Parallax 60fps',
    time: 'Fase Interactiva',
    title: 'Profundidad Visual Acelerada por GPU',
    description:
      'Integración de capas Parallax mediante CSS Scroll-Driven Animations y translate3d(), logrando fluidez de 60 cuadros por segundo en escritorio y dispositivos móviles.',
  },
  {
    step: '04',
    phase: 'Cloud Computing & CI/CD',
    time: 'Fase de Producción',
    title: 'Despliegue en la Nube y Distribución Global CDN',
    description:
      'Puesta en producción aplicando buenas prácticas de Cloud Computing: pipelines automatizados, certificados SSL, distribución edge y auditoría Lighthouse 100/100.',
  },
];
---

<!-- SECCIÓN DE PERFIL PROFESIONAL Y EXPERIENCIA -->
<section id="experiencia" class="section-block section-block--alt" aria-labelledby="experience-heading">
  <header class="container section-header" data-reveal>
    <p class="eyebrow-tag">// 03. PERFIL PROFESIONAL &amp; EXPERIENCIA</p>
    <h2 id="experience-heading" class="section-title">
      Sistemas, operaciones y <mark class="text-gradient">soporte tecnológico</mark>
    </h2>
    <p class="section-subtitle">
      Profesional de sistemas y redes informáticas con experiencia en facturación nacional, atención mayorista, soporte TI y proyectos web con Astro.
    </p>
  </header>

  <section class="container credentials-grid" aria-label="Experiencia y fortalezas profesionales">
    {
      professionalHighlights.map((item) => (
        <article class="credential-card" data-tilt data-reveal>
          <header class="credential-card-top">
            <small class="credential-code">{item.code}</small>
            <mark class="credential-badge">{item.badge}</mark>
          </header>
          <h3 class="credential-title">{item.title}</h3>
          <p class="credential-institution">{item.institution}</p>
          <p class="credential-desc">{item.description}</p>
          <ul class="tag-list credential-tags" aria-label="Competencias">
            {item.highlights.map((highlight) => <li class="tech-tag">{highlight}</li>)}
          </ul>
        </article>
      ))
    }
  </section>
</section>

<!-- SECCIÓN DE FORMACIÓN ACADÉMICA, CLOUD COMPUTING Y CERTIFICACIONES -->
<section id="credenciales" class="section-block" aria-labelledby="credentials-heading">
  <header class="container section-header" data-reveal>
    <p class="eyebrow-tag">// 04. FORMACIÓN ACADÉMICA &amp; CLOUD</p>
    <h2 id="credentials-heading" class="section-title">
      Ingeniería, <mark class="text-gradient">Cloud Computing</mark> y desarrollo web
    </h2>
    <p class="section-subtitle">
      Formación universitaria, especialización en nube y aprendizaje práctico orientado a resolver necesidades reales de negocio.
    </p>
  </header>

  <section class="container credentials-grid" aria-label="Títulos y certificaciones profesionales">
    {
      credentials.map((cred) => (
        <article
          class="credential-card"
          data-parallax={cred.parallax}
          data-parallax-mode="local"
          data-tilt
          data-reveal
        >
          <header class="credential-card-top">
            <small class="credential-code">{cred.code}</small>
            <mark class="credential-badge">{cred.badge}</mark>
          </header>

          <h3 class="credential-title">{cred.title}</h3>
          <p class="credential-institution">{cred.institution}</p>
          <p class="credential-desc">{cred.description}</p>

          <ul class="tag-list credential-tags" aria-label="Competencias clave">
            {cred.highlights.map((item) => (
              <li class="tech-tag">{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</section>

<!-- SECCIÓN METODOLOGÍA DE INGENIERÍA -->
<section id="proceso" class="section-block section-block--alt" aria-labelledby="process-heading">
  <header class="container section-header" data-reveal>
    <p class="eyebrow-tag">// 05. METODOLOGÍA DE INGENIERÍA</p>
    <h2 id="process-heading" class="section-title">
      Del análisis de sistemas al <mark class="text-gradient">despliegue en la nube</mark>
    </h2>
    <p class="section-subtitle">
      Un flujo de ingeniería disciplinado donde la estética moderna se une con estándares de Cloud Computing y calidad de código fuente.
    </p>
  </header>

  <ol class="container process-timeline" aria-label="Etapas del proceso de desarrollo">
    {
      steps.map((item, idx) => (
        <li class="timeline-item" data-reveal>
          <aside
            class="timeline-badge"
            data-parallax={idx % 2 === 0 ? '-0.04' : '0.04'}
            data-parallax-mode="local"
            aria-hidden="true"
          >
            <span>{item.step}</span>
          </aside>

          <article class="timeline-card" data-tilt>
            <header class="timeline-card-header">
              <small class="timeline-phase">{item.phase}</small>
              <time class="timeline-duration" datetime={`P${idx + 1}D`}>{item.time}</time>
            </header>
            <h3 class="timeline-title">{item.title}</h3>
            <p class="timeline-desc">{item.description}</p>
          </article>
        </li>
      ))
    }
  </ol>
</section>
