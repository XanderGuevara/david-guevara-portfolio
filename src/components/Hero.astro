---
---

<section id="inicio" class="hero-section" aria-labelledby="hero-heading">
  <!-- Marca de agua tipográfica gigante con Parallax profundo -->
  <figure class="hero-parallax-watermark" aria-hidden="true" data-parallax="0.24">
    <span>ASTRO // SEMANTIC HTML5 // 60FPS</span>
  </figure>

  <section class="container hero-grid" aria-label="Presentación principal">
    <!-- Columna Principal: Propuesta de Valor -->
    <article class="hero-copy" data-reveal>
      <p class="eyebrow-tag">
        <span class="eyebrow-code">// ING. EN SISTEMAS • CLOUD COMPUTING • KODIGO CERTIFIED</span>
      </p>

      <h1 id="hero-heading" class="hero-title">
        Ingeniería de sistemas, arquitectura <mark class="text-gradient">Cloud</mark> y web en <mark class="text-gradient">Astro</mark>.
      </h1>

      <p class="hero-lead">
        Soy el <strong>Ing. David Guevara</strong>, <strong>Ingeniero en Sistemas</strong> con preespecialización en <strong>Cloud Computing</strong> y certificado por la <strong>Academia Kodigo como Web Developer Jr.</strong> Construyo plataformas rápidas en Astro con efectos Parallax a 60fps y mi firma innegociable: <strong>código HTML5 100% semántico</strong>.
      </p>

      <ul class="hero-credentials-strip" aria-label="Credenciales académicas y certificaciones">
        <li>
          <mark class="cred-pill">🎓 Ingeniero en Sistemas</mark>
        </li>
        <li>
          <mark class="cred-pill">☁️ Preespecialización Cloud Computing</mark>
        </li>
        <li>
          <mark class="cred-pill">🏅 Kodigo Academy — Web Developer Jr.</mark>
        </li>
      </ul>

      <menu class="hero-cta-group" aria-label="Acciones principales">
        <li>
          <a href="#proyectos" class="btn btn--primary">
            <span>Explorar Casos de Estudio</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
        <li>
          <a href="#firma-semantica" class="btn btn--glass">
            <span>Auditar Firma HTML5</span>
          </a>
        </li>
      </menu>

      <dl class="hero-metrics" aria-label="Indicadores de rendimiento y calidad">
        <article class="metric-item">
          <dt class="metric-label">Lighthouse Performance</dt>
          <dd class="metric-value">100<small>/100</small></dd>
        </article>
        <article class="metric-item">
          <dt class="metric-label">Etiquetas &lt;div&gt; en el DOM</dt>
          <dd class="metric-value">0<small> div-soup</small></dd>
        </article>
        <article class="metric-item">
          <dt class="metric-label">Motor Parallax</dt>
          <dd class="metric-value">60<small> FPS</small></dd>
        </article>
      </dl>
    </article>

    <!-- Columna Derecha: Escenario 3D Parallax con Firma de Código en Vivo -->
    <figure
      class="hero-showcase-stage"
      data-parallax="-0.08"
      data-parallax-mode="local"
      data-tilt
      data-reveal
      aria-label="Inspección visual de la arquitectura semántica en Astro"
    >
      <!-- Insignias flotantes en distintas capas de profundidad Z/Parallax -->
      <aside class="floating-badge floating-badge--top" data-parallax="-0.14" data-parallax-mode="local">
        <span class="badge-icon" aria-hidden="true">⚡</span>
        <span>
          <strong>Astro 5 Islands</strong>
          <small>Zero-JS por defecto</small>
        </span>
      </aside>

      <article class="code-window">
        <header class="code-window-header">
          <span class="window-controls" aria-hidden="true">
            <i class="dot dot--red"></i>
            <i class="dot dot--amber"></i>
            <i class="dot dot--emerald"></i>
          </span>
          <small class="window-filename">src/layouts/SemanticSignature.astro</small>
          <mark class="window-status">VALID W3C</mark>
        </header>

        <pre class="code-window-body"><code><span class="c-comment">&lt;!-- Firma Estructural: Cero &lt;div&gt; --&gt;</span>
<span class="c-tag">&lt;header</span> <span class="c-attr">role</span>=<span class="c-str">"banner"</span><span class="c-tag">&gt;</span>
  <span class="c-tag">&lt;nav</span> <span class="c-attr">aria-label</span>=<span class="c-str">"Principal"</span><span class="c-tag">&gt;...&lt;/nav&gt;</span>
<span class="c-tag">&lt;/header&gt;</span>

<span class="c-tag">&lt;main</span> <span class="c-attr">id</span>=<span class="c-str">"contenido-principal"</span><span class="c-tag">&gt;</span>
  <span class="c-tag">&lt;section</span> <span class="c-attr">data-parallax</span>=<span class="c-str">"0.15"</span><span class="c-tag">&gt;</span>
    <span class="c-tag">&lt;article</span> <span class="c-attr">class</span>=<span class="c-str">"case-study"</span><span class="c-tag">&gt;</span>
      <span class="c-tag">&lt;figure&gt;</span>
        <span class="c-tag">&lt;picture&gt;...&lt;/picture&gt;</span>
        <span class="c-tag">&lt;figcaption&gt;</span>Impacto Real<span class="c-tag">&lt;/figcaption&gt;</span>
      <span class="c-tag">&lt;/figure&gt;</span>
    <span class="c-tag">&lt;/article&gt;</span>
  <span class="c-tag">&lt;/section&gt;</span>
<span class="c-tag">&lt;/main&gt;</span>

<span class="c-tag">&lt;footer&gt;</span>
  <span class="c-tag">&lt;aside</span> <span class="c-attr">class</span>=<span class="c-str">"author-signature"</span><span class="c-tag">&gt;</span>
    Desarrollado por <span class="c-tag">&lt;strong&gt;</span>David Guevara<span class="c-tag">&lt;/strong&gt;</span>
  <span class="c-tag">&lt;/aside&gt;</span>
<span class="c-tag">&lt;/footer&gt;</span></code></pre>

        <figcaption class="code-window-footer">
          <span>DOM Tree: <strong>100% Semántico</strong></span>
          <span>Accesibilidad: <strong>WCAG AA/AAA</strong></span>
        </figcaption>
      </article>

      <aside class="floating-badge floating-badge--bottom" data-parallax="0.12" data-parallax-mode="local">
        <span class="badge-icon" aria-hidden="true">✦</span>
        <span>
          <strong>Firma David Guevara</strong>
          <small>HTML5 Puro + Parallax 60fps</small>
        </span>
      </aside>
    </figure>
  </section>
</section>
