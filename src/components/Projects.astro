---

<!-- SECCIÓN 1: CASOS DE ESTUDIO EN ASTRO CON PARALLAX ASIMÉTRICO -->
<section id="proyectos" class="section-block" aria-labelledby="projects-heading">
  <header class="container section-header" data-reveal>
    <p class="eyebrow-tag">// 01. CASOS DE ESTUDIO DESTACADOS</p>
    <h2 id="projects-heading" class="section-title">
      Proyectos construidos con <mark class="text-gradient">Astro &amp; Parallax</mark>
    </h2>
    <p class="section-subtitle">
      Cada proyecto combina velocidad de carga extrema, capas de profundidad visual y una estructura DOM semántica pensada para posicionamiento SEO y mantenibilidad.
    </p>
  </header>

  <section class="container case-studies-stack" aria-label="Lista de casos de estudio principales">
    {
      featuredProjects.map((project, index) => (
        <article
          class={`case-study-card ${index % 2 === 1 ? 'case-study-card--reverse' : ''} ${project.isFlagship ? 'case-study-card--flagship' : ''}`}
          data-reveal
        >
          <!-- Capa Visual con Velocidad Parallax Independiente -->
          <figure
            class={`case-visual case-visual--${project.accent}`}
            data-parallax={project.parallaxVisual}
            data-parallax-mode="local"
            data-tilt
          >
            <header class="browser-chrome" aria-hidden="true">
              <span class="window-controls">
                <i class="dot dot--red" />
                <i class="dot dot--amber" />
                <i class="dot dot--emerald" />
              </span>
              <small class="browser-url">
                {project.isFlagship ? 'colegiocrismag.com' : `${project.id}.astro.build`}
              </small>
              {project.isFlagship && <mark class="window-status">★ MEJOR PROYECTO</mark>}
            </header>

            <section class="visual-canvas" aria-label={`Vista previa conceptual de ${project.title}`}>
              <span class="visual-index" aria-hidden="true">{project.number}</span>
              <h3 class="visual-brand-title">{project.title.split('—')[0]}</h3>
              <ul class="visual-metrics-pills">
                {project.metrics.map((metric) => (
                  <li>{metric}</li>
                ))}
              </ul>
            </section>

            <figcaption class="visual-caption">
              <span>Arquitectura: <strong>HTML5 Semántico + Astro</strong></span>
              <span>Render: <strong>SSG Estático</strong></span>
            </figcaption>
          </figure>

          <!-- Capa de Contenido con Parallax Contrapuesto -->
          <section
            class="case-body"
            data-parallax={project.parallaxContent}
            data-parallax-mode="local"
            aria-label={`Detalles técnicos de ${project.title}`}
          >
            <header class="case-meta">
              <mark class="case-number">{project.number}</mark>
              <small class={`case-category ${project.isFlagship ? 'case-category--flagship' : ''}`}>
                {project.category}
              </small>
            </header>

            <h3 class="case-title">{project.title}</h3>

            <dl class="case-narrative">
              <article class="narrative-item">
                <dt>El Reto</dt>
                <dd>{project.challenge}</dd>
              </article>
              <article class="narrative-item">
                <dt>Solución &amp; Firma Semántica</dt>
                <dd>{project.solution}</dd>
              </article>
            </dl>

            <ul class="tag-list" aria-label="Tecnologías utilizadas">
              {project.stack.map((tech) => (
                <li class="tech-tag">{tech}</li>
              ))}
            </ul>

            <footer class="case-actions">
              <a
                href={project.liveUrl}
                target={project.liveUrl.startsWith('http') ? '_blank' : undefined}
                rel={project.liveUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="btn btn--outline"
              >
                <span>
                  {project.liveUrl.startsWith('http')
                    ? 'Explorar Despliegue en Vivo'
                    : 'Solicitar Demo Técnica'}
                </span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </footer>
          </section>
        </article>
      ))
    }
  </section>
</section>

<!-- SECCIÓN 2: THE ULTIMATE WEB SUITE (CATÁLOGO COMERCIAL) -->
<section id="web-suite" class="section-block section-block--alt" aria-labelledby="suite-heading">
  <header class="container section-header" data-reveal>
    <p class="eyebrow-tag">// 02. THE ULTIMATE WEB SUITE</p>
    <h2 id="suite-heading" class="section-title">
      Soluciones Comerciales <mark class="text-gradient">Listas para Producción</mark>
    </h2>
    <p class="section-subtitle">
      Catálogo de arquitecturas web especializadas por industria, optimizadas para conversión local, velocidad móvil y despliegue inmediato.
    </p>

    <menu class="suite-filter-bar" aria-label="Filtrar catálogo por industria">
      <li><button type="button" class="filter-chip is-active" data-filter="all">Todas (5)</button></li>
      <li><button type="button" class="filter-chip" data-filter="salud">Salud</button></li>
      <li><button type="button" class="filter-chip" data-filter="gastronomia">Gastronomía</button></li>
      <li><button type="button" class="filter-chip" data-filter="bienestar">Belleza &amp; Spa</button></li>
      <li><button type="button" class="filter-chip" data-filter="comunidad">Comunidad</button></li>
      <li><button type="button" class="filter-chip" data-filter="tecnologia">Tecnología</button></li>
    </menu>
  </header>

  <section class="container suite-grid" aria-label="Plantillas comerciales en vivo">
    {
      webSuiteItems.map((item, idx) => (
        <article
          class="suite-card"
          data-category={item.filter}
          data-tilt
          data-reveal
          style={`--stagger: ${idx * 70}ms;`}
        >
          <header class="suite-card-top">
            <small class="suite-sector">{item.sector}</small>
            <mark class="suite-badge">Demo Activa</mark>
          </header>

          <h3 class="suite-card-title">{item.title}</h3>
          <p class="suite-card-desc">{item.description}</p>

          <ul class="tag-list suite-tags" aria-label="Características incluidas">
            {item.tags.map((t) => (
              <li class="tech-tag">{t}</li>
            ))}
          </ul>

          <footer class="suite-card-footer">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="suite-demo-link"
              aria-label={`Ver demostración en vivo de ${item.title} (abre en una nueva pestaña)`}
            >
              <span>Ver Demo en Vivo</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </footer>
        </article>
      ))
    }
  </section>
</section>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const suiteCards = Array.from(document.querySelectorAll<HTMLElement>('.suite-card[data-category]'));

  for (const btn of filterButtons) {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter || 'all';

      for (const b of filterButtons) {
        b.classList.toggle('is-active', b === btn);
      }

      for (const card of suiteCards) {
        const matches = selected === 'all' || card.dataset.category === selected;
        card.hidden = !matches;
      }
    });
  }
</script>
