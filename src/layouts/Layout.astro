---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ing. David Guevara — Ingeniero en Sistemas, Cloud Computing & Astro Web Developer',
  description = 'Portafolio profesional de David Alexander Guevara: profesional de sistemas y redes informáticas, egresado de Ingeniería en Sistemas y Redes Informáticas, con preespecialización en Cloud Computing y experiencia en soporte TI, operaciones y desarrollo web con Astro.',
} = Astro.props;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Guevara',
  honorificPrefix: 'Ing.',
  url: 'https://xanderguevara.github.io/david-guevara-portfolio/',
  jobTitle: 'Profesional de Sistemas y Redes Informáticas | Soporte TI, Cloud y Desarrollo Web',
  sameAs: ['https://github.com/XanderGuevara'],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Ingeniería en Sistemas y Redes Informáticas — egresado',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Preespecialización en Cloud Computing',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Bootcamp de Desarrollo Web Junior — Academia Kodigo, en curso',
    },
  ],
  knowsAbout: [
    'Ingeniería en Sistemas',
    'Cloud Computing & Despliegue en la Nube',
    'Astro Framework',
    'Semantic HTML5',
    'Web Accessibility (WCAG / ARIA)',
    'CSS Scroll-Driven Animations',
    '60fps Parallax Effects',
    'Core Web Vitals & SEO Técnico',
    'Soporte técnico y redes',
    'Facturación nacional y atención mayorista',
  ],
};
---

<!doctype html>
<!--
  ==========================================================================
  FIRMA ARQUITECTÓNICA: DAVID GUEVARA
  Stack: Astro 5 | Motor Parallax Híbrido 60fps | 100% HTML5 Semántico Puro
  Cero <div-soup> — Accesibilidad, Velocidad y Precisión Estructural.
  ==========================================================================
-->
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="David Guevara" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_LA" />

    <!-- Fuentes Modernas: Space Grotesk + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>

    <!-- Datos Estructurados JSON-LD Semánticos -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">
      Saltar al contenido principal
    </a>

    <!-- Escenario Ambiental Multicapa con Parallax + Red Cuántica en Vivo (Semántico: <figure aria-hidden="true">) -->
    <figure class="ambient-cosmos" aria-hidden="true">
      <span class="cosmos-grid" data-parallax="-0.16"></span>
      <span class="cosmos-orb cosmos-orb--emerald" data-parallax="-0.26"></span>
      <span class="cosmos-orb cosmos-orb--cyan" data-parallax="0.22"></span>
      <span class="cosmos-orb cosmos-orb--center" data-parallax="-0.14"></span>
      <canvas id="cosmos-canvas" class="cosmos-canvas"></canvas>
      <span class="cosmos-spotlight" id="cursor-spotlight"></span>
    </figure>

    <!-- Barra de progreso de lectura superior impulsada por Scroll -->
    <aside class="scroll-progress-track" aria-hidden="true">
      <span class="scroll-progress-bar" id="scroll-progress-bar"></span>
    </aside>

    <slot />

    <script>
      // Motor Parallax Híbrido 60fps + Spotlight + Scroll Progress (0 dependencias, GPU-accelerated)
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const parallaxNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      const tiltCards = Array.from(document.querySelectorAll<HTMLElement>('[data-tilt]'));
      const revealNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const progressBar = document.getElementById('scroll-progress-bar');

      let ticking = false;

      const updateScrollEffects = () => {
        const scrollY = window.scrollY;
        const maxScroll = Math.max(
          document.documentElement.scrollHeight - window.innerHeight,
          1
        );
        const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

        if (progressBar) {
          progressBar.style.transform = `scaleX(${progress})`;
        }

        if (!reducedMotion.matches) {
          const viewportCenter = window.innerHeight * 0.5;

          for (const node of parallaxNodes) {
            const speed = parseFloat(node.dataset.parallax || '0');
            const mode = node.dataset.parallaxMode || 'global';

            if (mode === 'local') {
              const rect = node.getBoundingClientRect();
              const elementCenter = rect.top + rect.height * 0.5;
              const delta = elementCenter - viewportCenter;
              const offsetY = delta * speed;
              node.style.transform = `translate3d(0, ${offsetY.toFixed(2)}px, 0)`;
            } else {
              const offsetY = scrollY * speed;
              node.style.transform = `translate3d(0, ${offsetY.toFixed(2)}px, 0)`;
            }
          }
        } else {
          for (const node of parallaxNodes) {
            node.style.transform = 'translate3d(0, 0, 0)';
          }
        }

        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(updateScrollEffects);
            ticking = true;
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', updateScrollEffects, { passive: true });
      updateScrollEffects();

      // Cursor Spotlight & Micro-Parallax 3D en el Hero
      if (!reducedMotion.matches && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener(
          'pointermove',
          (e) => {
            document.documentElement.style.setProperty('--cursor-x', `${e.clientX}px`);
            document.documentElement.style.setProperty('--cursor-y', `${e.clientY}px`);
          },
          { passive: true }
        );

        for (const card of tiltCards) {
          card.addEventListener('pointermove', (e) => {
            const rect = card.getBoundingClientRect();
            const relX = (e.clientX - rect.left) / rect.width - 0.5;
            const relY = (e.clientY - rect.top) / rect.height - 0.5;
            card.style.setProperty('--tilt-x', `${(relY * -5).toFixed(2)}deg`);
            card.style.setProperty('--tilt-y', `${(relX * 5).toFixed(2)}deg`);
            card.style.setProperty('--glow-x', `${((relX + 0.5) * 100).toFixed(1)}%`);
            card.style.setProperty('--glow-y', `${((relY + 0.5) * 100).toFixed(1)}%`);
          });

          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
          });
        }
      }

      // IntersectionObserver para revelación progresiva de secciones
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        for (const el of revealNodes) {
          observer.observe(el);
        }
      } else {
        for (const el of revealNodes) {
          el.classList.add('is-visible');
        }
      }

      // Red de Partículas Multicapa + Haz de Datos con Parallax Reactivo al Scroll y Cursor (60fps)
      const canvas = document.getElementById('cosmos-canvas') as HTMLCanvasElement | null;
      if (canvas && !reducedMotion.matches) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = (canvas.width = window.innerWidth);
          let height = (canvas.height = window.innerHeight);

          let mouseX = width * 0.5;
          let mouseY = height * 0.35;
          let lastScrollY = window.scrollY;
          let scrollMomentum = 0;

          window.addEventListener(
            'resize',
            () => {
              width = canvas.width = window.innerWidth;
              height = canvas.height = window.innerHeight;
            },
            { passive: true }
          );

          window.addEventListener(
            'pointermove',
            (e) => {
              mouseX = e.clientX;
              mouseY = e.clientY;
            },
            { passive: true }
          );

          window.addEventListener(
            'scroll',
            () => {
              const currentScroll = window.scrollY;
              const delta = currentScroll - lastScrollY;
              scrollMomentum = Math.max(Math.min(scrollMomentum + delta * 0.18, 28), -28);
              lastScrollY = currentScroll;
            },
            { passive: true }
          );

          interface Particle {
            x: number;
            y: number;
            vx: number;
            vy: number;
            radius: number;
            depth: number;
            color: string;
            alpha: number;
          }

          interface PulseBeam {
            x: number;
            y: number;
            length: number;
            speed: number;
            horizontal: boolean;
            color: string;
          }

          const particleCount = Math.min(Math.floor((width * height) / 18000), 68);
          const particles: Particle[] = [];

          for (let i = 0; i < particleCount; i++) {
            const isEmerald = i % 2 === 0;
            const depth = 0.35 + Math.random() * 1.15;
            particles.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.65 * depth,
              vy: (Math.random() - 0.5) * 0.65 * depth,
              radius: (Math.random() * 1.8 + 0.9) * depth,
              depth,
              color: isEmerald ? '16, 185, 129' : '6, 182, 212',
              alpha: 0.25 + Math.random() * 0.45,
            });
          }

          const beams: PulseBeam[] = Array.from({ length: 4 }, (_, i) => ({
            x: Math.random() * width,
            y: Math.random() * height,
            length: 90 + Math.random() * 120,
            speed: 2.2 + Math.random() * 2.5,
            horizontal: i % 2 === 0,
            color: i % 2 === 0 ? '16, 185, 129' : '6, 182, 212',
          }));

          const renderCosmos = () => {
            ctx.clearRect(0, 0, width, height);
            scrollMomentum *= 0.9;

            // Dibujar haces de luz (data streams) que cruzan el fondo
            for (const beam of beams) {
              ctx.save();
              if (beam.horizontal) {
                beam.x += beam.speed;
                if (beam.x - beam.length > width) {
                  beam.x = -beam.length;
                  beam.y = Math.random() * height;
                }
                const grad = ctx.createLinearGradient(beam.x - beam.length, beam.y, beam.x, beam.y);
                grad.addColorStop(0, `rgba(${beam.color}, 0)`);
                grad.addColorStop(1, `rgba(${beam.color}, 0.28)`);
                ctx.strokeStyle = grad;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.moveTo(beam.x - beam.length, beam.y);
                ctx.lineTo(beam.x, beam.y);
                ctx.stroke();
              } else {
                beam.y += beam.speed - scrollMomentum * 0.25;
                if (beam.y - beam.length > height) {
                  beam.y = -beam.length;
                  beam.x = Math.random() * width;
                } else if (beam.y < -beam.length) {
                  beam.y = height + beam.length;
                }
                const grad = ctx.createLinearGradient(beam.x, beam.y - beam.length, beam.x, beam.y);
                grad.addColorStop(0, `rgba(${beam.color}, 0)`);
                grad.addColorStop(1, `rgba(${beam.color}, 0.25)`);
                ctx.strokeStyle = grad;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.moveTo(beam.x, beam.y - beam.length);
                ctx.lineTo(beam.x, beam.y);
                ctx.stroke();
              }
              ctx.restore();
            }

            // Actualizar y dibujar partículas con profundidad Parallax
            for (let i = 0; i < particles.length; i++) {
              const p = particles[i];
              p.x += p.vx;
              p.y += p.vy - scrollMomentum * 0.42 * p.depth;

              // Envoltura suave de bordes
              if (p.x < -20) p.x = width + 20;
              if (p.x > width + 20) p.x = -20;
              if (p.y < -20) p.y = height + 20;
              if (p.y > height + 20) p.y = -20;

              // Interacción magnética sutil con el cursor
              const dxMouse = mouseX - p.x;
              const dyMouse = mouseY - p.y;
              const distMouse = Math.hypot(dxMouse, dyMouse);

              if (distMouse < 165) {
                const factor = (1 - distMouse / 165) * 0.22;
                ctx.strokeStyle = `rgba(${p.color}, ${factor.toFixed(3)})`;
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(mouseX, mouseY);
                ctx.stroke();
              }

              // Nodo luminoso
              ctx.fillStyle = `rgba(${p.color}, ${p.alpha})`;
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
              ctx.fill();

              // Conexiones de constelación entre nodos cercanos
              for (let j = i + 1; j < particles.length; j++) {
                const p2 = particles[j];
                const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                if (dist < 130) {
                  const lineAlpha = (1 - dist / 130) * 0.14;
                  ctx.strokeStyle = `rgba(16, 185, 129, ${lineAlpha.toFixed(3)})`;
                  ctx.lineWidth = 0.8;
                  ctx.beginPath();
                  ctx.moveTo(p.x, p.y);
                  ctx.lineTo(p2.x, p2.y);
                  ctx.stroke();
                }
              }
            }

            window.requestAnimationFrame(renderCosmos);
          };

          window.requestAnimationFrame(renderCosmos);
        }
      }
    </script>
  </body>
</html>
